# 环境变量模板。复制成 .env 后按需改，.env 不进版本库。
# 配置优先级：命令行 flag > 环境变量 > 默认值。

# 监听地址。只监听回环，外面连不到，由 Nginx 反代进来。
MIRAGE_ADDR=127.0.0.1:8091

# 数据库路径。开发和生产是两份。
MIRAGE_DB=data.db

# 附件目录。本期不启用，只占个位置。
MIRAGE_UPLOADS=uploads

# 静态资源根目录。开发模式从这里发 /assets/。
MIRAGE_STATIC=static

# 会话有效期，Go 的时长格式（168h = 7 天）。
MIRAGE_SESSION_TTL=168h

# 签名密钥。只从环境变量读，不给 flag——命令行参数在进程列表里是明文。
# 生成：openssl rand -hex 32
# M1 还没有签名逻辑，缺失只打一条 warn；M5 起缺失拒绝启动。
MIRAGE_SECRET=